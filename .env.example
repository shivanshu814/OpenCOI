# Public (browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server only
SUPABASE_SERVICE_ROLE_KEY=

# AI extraction — Claude via OpenRouter (not direct Anthropic)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Optional — model for the vendor portal support chat (F4). Falls back to
# OPENROUTER_MODEL. Whatever it resolves to is logged on every chat turn.
OPENROUTER_SUPPORT_MODEL=

# Inngest — production uses EVENT_KEY on Vercel.
# Local uploads run Claude inline by default (no worker needed).
# To queue via Inngest locally: set INNGEST_FORCE_QUEUE=1 and run
#   npx inngest-cli@latest dev
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_DEV=1
# INNGEST_FORCE_QUEUE=1


# Email-in (B1) — Postmark inbound → POST /api/webhooks/postmark/inbound
# Point inbound stream webhook at {APP_URL}/api/webhooks/postmark/inbound
# MX for in.getcertshield.app → Postmark; address format {org.intake_token}@domain
INBOUND_EMAIL_DOMAIN=in.getcertshield.app
POSTMARK_INBOUND_HOOK_TOKEN=
POSTMARK_INBOUND_BASIC_USER=
POSTMARK_INBOUND_BASIC_PASSWORD=

# Chase outbound — prefer personal SMTP until Resend domain is verified
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com
# SMTP_PASS = Google App Password (not your normal login password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=CertShield <shivanshu814pathak@gmail.com>

# Optional later — Resend (custom domain)
RESEND_API_KEY=
RESEND_FROM_EMAIL=CertShield <shivanshu814pathak@gmail.com>
# CAN-SPAM physical address line in chase footers
CHASE_PHYSICAL_ADDRESS=CertShield · US operations · shivanshu814pathak@gmail.com

# SMS chasing (C3) — Twilio + TCPA opt-in required per vendor
# A2P 10DLC registration required before prod sends
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Inbound STOP webhook: {APP_URL}/api/webhooks/twilio/sms

# W-9 TIN field encryption (A2) — 64-hex or any passphrase (sha256-derived)
TIN_ENCRYPTION_KEY=

# Documenso e-sign (A5)
DOCUMENSO_API_KEY=
DOCUMENSO_API_URL=https://app.documenso.com

# Paddle Billing (merchant of record) — sandbox until KYC clears
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_PRICE_STARTER=
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_BUSINESS=
PADDLE_API_KEY=
# Notification destination URL: {APP_URL}/api/webhooks/paddle
PADDLE_NOTIFICATION_WEBHOOK_SECRET=

# Sentry observability (errors + basic performance).
# ENTIRELY OPTIONAL: with no DSN the SDK is a no-op — builds and CI stay green.
# Set the DSN to turn capture on; source-map upload is not wired (no auth token).
NEXT_PUBLIC_SENTRY_DSN=
# Optional overrides (defaults shown):
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── SEO / AEO / GEO ────────────────────────────────────────────────────────
# Canonical marketing origin used in <link rel=canonical>, sitemap, JSON-LD and
# OG tags. Defaults to MARKETING_ORIGIN in src/lib/hosts.ts; set only if the
# domain changes.
NEXT_PUBLIC_SITE_URL=https://www.getcertshield.app
# Search Console / Bing Webmaster verification tokens (meta-tag method).
# Empty = the meta tag is omitted entirely.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# GA4 measurement ID (G-XXXXXXX). Unset = GA renders nothing (dev/preview safe).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# IndexNow key. Must match the filename in public/<key>.txt.
INDEXNOW_KEY=42d9b7e044e0ee66c99b157bd828305b

# ── SEO monitoring (Inngest `run-seo-monitor`, every 12h) ──────────────────
# The job runs useful with NONE of the below set: the crawl, the IndexNow push
# and PageSpeed all work unauthenticated. Each key below only widens what it
# can measure, and anything unset is recorded as "skipped" with its reason
# rather than silently reported as zero.
#
# Where the alert email goes. Defaults to ORG.email in src/lib/seo/site.ts.
SEO_ALERT_EMAIL=
# PageSpeed Insights API key — free, no card. Keyless works but is rate-limited;
# a key raises the quota to 25k/day. console.cloud.google.com → Credentials →
# API key, restricted to the PageSpeed Insights API.
PAGESPEED_API_KEY=
# Search Console. Two separate things:
#  · GSC_PROPERTY — the property id. URL-prefix properties are the origin with a
#    trailing slash; a domain property is `sc-domain:getcertshield.app` and is
#    strictly better (covers every subdomain and scheme). Defaults to the site
#    URL + "/".
GSC_PROPERTY=
#  · GOOGLE_SEO_CREDENTIALS_JSON — the RAW service-account key JSON, on one
#    line, for the server-side job (a server has no browser for the consent
#    flow the CLI scripts use). The service account must also be added as an
#    **owner** of the property in Search Console; "full access" is not enough
#    and a 403 here is almost always that. Note that Google now applies the
#    `iam.disableServiceAccountKeyCreation` org policy to new projects by
#    default, so minting this key may require lifting that policy first — the
#    job is built to run without it indefinitely.
GOOGLE_SEO_CREDENTIALS_JSON=

# ── SEO scripts only (scripts/seo/*, never read at runtime) ────────────────
# SerpAPI rank tracking. Free tier is 100 searches/month and the keyword map is
# 21 terms, so run `npm run seo:ranks` weekly, not daily. Search Console covers
# the daily signal for free and without a quota.
SERPAPI_KEY=

# ── Intercom (in-app support chat) ─────────────────────────────────────────
# The messenger boots ONLY inside /app, for signed-in users, after idle.
# App id is public and defaults to the live workspace in src/lib/intercom.ts.
NEXT_PUBLIC_INTERCOM_APP_ID=
# Identity-verification secret (Intercom → Messenger → Secure the messenger).
# REQUIRED for the messenger to appear: with no secret no user_hash can be
# computed and the widget refuses to boot, because an unverified messenger lets
# anyone impersonate a customer and read their conversations. Server-only —
# never prefix this with NEXT_PUBLIC_.
INTERCOM_SECRET_KEY=
